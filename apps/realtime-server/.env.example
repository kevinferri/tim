# Copy to .env.local, or just run `pnpm setup:env` from the repo root, which
# fills in everything below except the "requires a real credential" vars.
# See root CLAUDE.md's "Local environment setup" section for the full story.

WS_PORT=2428

# These three must be byte-identical to apps/chat's .env.local (shared JWT
# verification + message encryption between the two services)
FRONTEND_URL=http://localhost:3000
JWT_SECRET= # auto
CRYPTO_KEY= # auto

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tim
# DATABASE_SSL_CERT is production-only, not needed locally

DEBUG=

# Optional locally -- leave blank and /giphy falls back to a real, permanent
# Giphy CDN URL instead of failing. See src/lib/media-fetchers.ts:getRandomGif.
# Real value: https://developers.giphy.com/dashboard/
GIPHY_KEY=

# Optional locally -- leave blank and /youtube falls back to a real YouTube
# video URL instead of failing. See src/lib/media-fetchers.ts:getYoutubeVideo.
# Real values: https://console.cloud.google.com/apis/credentials (YouTube Data API v3)
YOUTUBE_ID=
YOUTUBE_SECRET=
YOUTUBE_KEY=

# Optional locally -- leave blank and /tim falls back to a canned reply
# instead of failing. See src/lib/open-ai.ts:callOpenAI.
# Real value: https://platform.openai.com/api-keys
OPENAI_API_KEY=
