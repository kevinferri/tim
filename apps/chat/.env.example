# Copy to .env.local, or just run `pnpm setup:env` from the repo root, which
# fills in everything below except the "requires a real credential" vars.
# See root CLAUDE.md's "Local environment setup" section for the full story.

# start-shared -- these three must be byte-identical to apps/realtime-server's
# .env.local (shared JWT verification + message encryption between the two services)
FRONTEND_URL=http://localhost:3000
JWT_SECRET= # auto
CRYPTO_KEY= # auto
# end-shared

# start fe-specific
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tim

# Requires a real credential: create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type "Web application",
# authorized redirect URI matching GOOGLE_CALLBACK_URL below).
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # auto
NEXTAUTH_COOKIE_KEY=next-auth.session-token

WS_SERVER_URL=http://localhost:2428
WS_SERVER_PATH=/ws/

# Optional locally -- leave blank and image uploads fall back to a real
# Cloudinary demo asset instead of failing. See src/lib/cloudinary.ts:uploadImage.
# Real value: https://cloudinary.com/console (Dashboard -> "API Environment variable").
CLOUDINARY_URL=
# end fe-specific
