{
  "name": "chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "node scripts/db.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "yarn db:up && npx dotenv -e .env.local -- prisma db push",
    "db:reset": "yarn db:up && npx dotenv -e .env.local -- prisma migrate reset",
    "db:generate": "npx dotenv -e .env.local -- prisma generate",
    "db:studio": "yarn db:up && npx dotenv -e .env.local -- prisma studio",
    "db:genpush": "yarn db:generate && yarn db:push",
    "production:build": "npx prisma generate && npx prisma migrate deploy && next build",
    "db:migrate": "yarn db:up && npx dotenv -e .env.local -- prisma migrate dev"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
