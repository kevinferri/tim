    "lodash.keyby": "^4.6.0",
    "lodash.uniqby": "^4.7.0",
    "lucide-react": "^0.334.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "next-themes": "^0.3.0",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-draggable": "^4.5.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4",
