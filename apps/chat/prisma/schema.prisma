// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specific
  name             String?
  // Seeded from the first word of `name` at sign-up; user-editable after that.
  displayName      String
  email            String? @unique
  imageUrl         String?
  googleId         String  @unique
  status           String?
  lastStatusUpdate DateTime?

  // Relations
  createdCircles    Circle[]          @relation("circlesCreatedByUser")
  createdTopics     Topic[]           @relation("topicsCreatedByUser")
  circleMemberships Circle[]          @relation("circleMembershipsForUser")
  messages          Message[]         @relation("messagesSentByUser")
  highlights        Highlight[]       @relation("highlightsByUser")
  topicReadStates   TopicReadState[]  @relation("topicReadStatesForUser")
  topicPreferences  TopicPreference[] @relation("topicPreferencesForUser")
  notificationsReceived Notification[] @relation("notificationsForUser")
  notificationsSent     Notification[] @relation("notificationsByActor")
  samePageAnswers       SamePageAnswer[] @relation("samePageAnswersByUser")
  samePageCalls         SamePageAnswer[] @relation("samePageCallsByUser")
  samePageSocksHeld     SamePageSock[]   @relation("samePageSockHolder")
  samePagePlayerStats   SamePagePlayerStats[] @relation("samePageStatsForUser")
  wordsmithPlays       WordsmithPlay[]      @relation("wordsmithPlaysByUser")
  gameRoomSeen          GameRoomSeen[]        @relation("gameRoomSeenByUser")

  @@map(name: "users")
}

model Circle {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specific
  name           String
  description    String?
  imageUrl       String?
  userId         String
  defaultTopicId String? @unique

  // Relations
  createdBy    User    @relation("circlesCreatedByUser", fields: [userId], references: [id])
  members      User[]  @relation("circleMembershipsForUser")
  topics       Topic[] @relation("topicsInCircle")
  defaultTopic Topic?  @relation("defaultTopicForCircle", fields: [defaultTopicId], references: [id])
  samePageRounds SamePageRound[] @relation("samePageRoundsForCircle")
  samePageSock   SamePageSock?   @relation("samePageSockForCircle")
  samePagePlayerStats SamePagePlayerStats[] @relation("samePageStatsForCircle")
  games               CircleGame[]          @relation("gamesForCircle")
  gameRoomSeen        GameRoomSeen[]        @relation("gameRoomSeenInCircle")
  notifications       Notification[]        @relation("notificationsForCircle")

  @@index([userId])

  @@map(name: "circles")
}

model Topic {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specfic
  name        String
  description String?
  userId      String
  circleId    String

  // Relations
  createdBy        User              @relation("topicsCreatedByUser", fields: [userId], references: [id])
  parentCircle     Circle            @relation("topicsInCircle", fields: [circleId], references: [id], onDelete: Cascade)
  defaultForCircle Circle?           @relation("defaultTopicForCircle")
  messages         Message[]         @relation("messagesInTopic")
  readStates       TopicReadState[]  @relation("readStatesForTopic")
  preferences      TopicPreference[] @relation("userPreferencesForTopic")

  // circleId first: topics are looked up by circle, alone or with their creator.
  @@index([circleId, userId])

  @@map(name: "topics")
}

model Message {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specific
  text         String?
  mediaUrl     String?
  userId       String
  topicId      String
  replyToId    String?
  // Flat-thread root: null on roots; on replies = parent's threadRootId ?? parent.id.
  // Distinct from replyToId (the message being quoted).
  threadRootId String?
  // CommandName (canonical, so /yt is "youtube") the message was sent with; null for plain messages.
  // Lives outside `text` because that's encrypted at rest and can't be queried.
  command      String?

  // Relations
  sentBy     User        @relation("messagesSentByUser", fields: [userId], references: [id])
  topic      Topic       @relation("messagesInTopic", fields: [topicId], references: [id], onDelete: Cascade)
  highlights Highlight[] @relation("highlightsForMessage")
  // SetNull rather than Cascade: deleting the original message shouldn't
  // delete replies to it. Note this clears replyToId itself, not just the
  // relation -- once the original is gone there's no record the message
  // was ever a reply, so it silently renders as a plain message.
  replyTo    Message?    @relation("messageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]   @relation("messageReplies")
  // Also SetNull, with a wider blast radius: deleting a root nulls threadRootId
  // on every message in the thread, including reply-to-replies whose own
  // replyToId chain is still intact. Those keep their quote preview but leave
  // the thread, and replying to one starts a fresh thread rooted there.
  // Accepted -- re-deriving threadRootId from the surviving chain would need a
  // cascade the schema can't express.
  threadRoot Message?    @relation("messageThread", fields: [threadRootId], references: [id], onDelete: SetNull)
  threadReplies Message[] @relation("messageThread")
  notifications Notification[] @relation("notificationsForMessage")

  @@index([topicId, createdAt(sort: Desc)])
  @@index([userId, topicId])
  @@index([replyToId])
  @@index([threadRootId, createdAt])
  @@index([userId, command])

  @@map(name: "messages")
}

model Highlight {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specific 
  userId    String
  messageId String

  // Relations
  createdBy     User    @relation("highlightsByUser", fields: [userId], references: [id])
  message       Message @relation("highlightsForMessage", fields: [messageId], references: [id], onDelete: Cascade)

  // No separate @@index([userId]): the unique index covers it as its leftmost prefix.
  @@unique([userId, messageId])
  @@index([messageId])

  @@map(name: "highlights")
}

// Per-user read cursor: a topic is unread when someone else has a message newer than lastReadAt. No @updatedAt, so it only moves on an explicit mark-read.
model TopicReadState {
  userId     String
  topicId    String
  lastReadAt DateTime @default(now())

  // Relations
  user     User    @relation("topicReadStatesForUser", fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic   @relation("readStatesForTopic", fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([userId, lastReadAt(sort: Desc)])

  @@map(name: "topic_read_states")
}

// A user's own sidebar preferences for a topic (manual order, mute) --
// deliberately separate from TopicReadState, whose lastReadAt drives
// getUnreadTopicIds(). Keeping preferences here means no write path here
// needs to reason about accidentally clearing unread state.
model TopicPreference {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Specific
  userId    String
  topicId   String
  // Sparse: only set once a circle's topics have been manually reordered at
  // least once -- null sorts after any explicitly-ordered topics (new/never-
  // dragged topics land at the end, same as most chat apps).
  order     Float?
  isMuted   Boolean @default(false)

  // Relations
  user     User    @relation("topicPreferencesForUser", fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic   @relation("userPreferencesForTopic", fields: [topicId], references: [id], onDelete: Cascade)

  // No separate @@index([userId]): the unique index on (userId, topicId)
  // already covers userId-only lookups via its leftmost prefix.
  @@unique([userId, topicId])

  @@map(name: "topic_preferences")
}

model Notification {
  // Base
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Specific
  // Mirrors packages/socket-types' NotificationType values (e.g. "mention:received") --
  // kept as a plain string, not a Prisma enum, so socket-types stays the one canonical
  // source and adding a type never needs a migration.
  type        String
  recipientId String
  // Set for notifications about a message. Circle-level ones (e.g. games)
  // have no message or actor and set circleId instead.
  actorId     String?
  messageId   String?
  circleId    String?
  readAt      DateTime?

  // Relations
  recipient User     @relation("notificationsForUser", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("notificationsByActor", fields: [actorId], references: [id], onDelete: Restrict)
  message   Message? @relation("notificationsForMessage", fields: [messageId], references: [id], onDelete: Cascade)
  circle    Circle?  @relation("notificationsForCircle", fields: [circleId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([messageId])
  @@index([actorId])
  @@index([circleId])

  @@map(name: "notifications")
}

// Weekday Same Page round for a circle. gameDate is America/New_York YYYY-MM-DD.
model SamePageRound {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  circleId   String
  gameDate   String
  prompt     String
  revealedAt DateTime?
  // Claimed atomically so each alert is sent once per round.
  promptNotifiedAt DateTime?
  nudgeNotifiedAt  DateTime?
  revealNotifiedAt DateTime?

  circle  Circle           @relation("samePageRoundsForCircle", fields: [circleId], references: [id], onDelete: Cascade)
  answers SamePageAnswer[] @relation("samePageAnswersForRound")

  @@unique([circleId, gameDate])
  @@map(name: "same_page_rounds")
}

// Row present = that game is on for the circle (every game is off by default).
// gameId is each game's own id constant (e.g. "same-page").
model CircleGame {
  circleId  String
  gameId    String
  enabledAt DateTime @default(now())

  circle Circle @relation("gamesForCircle", fields: [circleId], references: [id], onDelete: Cascade)

  @@id([circleId, gameId])
  @@index([gameId])
  @@map(name: "circle_games")
}

// Badges the Game room button already showed a user today, so it only lights up for new ones.
model GameRoomSeen {
  userId    String
  circleId  String
  // Eastern YYYY-MM-DD; badgeKeys from an older day count as nothing seen.
  day       String
  // "<gameId>:<badge>", e.g. "same-page:results".
  badgeKeys String[]
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation("gameRoomSeenByUser", fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation("gameRoomSeenInCircle", fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@map(name: "game_room_seen")
}

model SamePageAnswer {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  roundId      String
  userId       String
  text         String
  // Normalized key used for clustering matches at reveal.
  matchKey     String
  calledUserId String?

  round      SamePageRound @relation("samePageAnswersForRound", fields: [roundId], references: [id], onDelete: Cascade)
  user       User          @relation("samePageAnswersByUser", fields: [userId], references: [id], onDelete: Cascade)
  calledUser User?         @relation("samePageCallsByUser", fields: [calledUserId], references: [id], onDelete: SetNull)

  @@unique([roundId, userId])
  @@index([userId])
  @@map(name: "same_page_answers")
}

// Current Sock holder for a circle (one row per circle).
model SamePageSock {
  circleId     String    @id
  holderUserId String?
  heldSince    DateTime?

  circle Circle @relation("samePageSockForCircle", fields: [circleId], references: [id], onDelete: Cascade)
  holder User?  @relation("samePageSockHolder", fields: [holderUserId], references: [id], onDelete: SetNull)

  @@map(name: "same_page_socks")
}

// Lifetime Same Page stats per user in a circle. Never resets.
model SamePagePlayerStats {
  circleId              String
  userId                String
  played                Int     @default(0)
  currentStreak         Int     @default(0)
  bestStreak            Int     @default(0)
  matchedRounds         Int     @default(0)
  correctCalls          Int     @default(0)
  callAttempts          Int     @default(0)
  samePageDays          Int     @default(0)
  socksEarned           Int     @default(0)
  sockDaysHeld          Int     @default(0)
  matchDist0            Int     @default(0)
  matchDist1            Int     @default(0)
  matchDist2            Int     @default(0)
  matchDist3Plus        Int     @default(0)
  // Unused; drop in a follow-up deploy once no running code reads it.
  promptViewedGameDate  String?
  // Last gameDate this user opened results (clears the results badge).
  resultsViewedGameDate String?

  circle Circle @relation("samePageStatsForCircle", fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation("samePageStatsForUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@map(name: "same_page_player_stats")
}

model WordsmithPlay {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  userId     String
  gameDate   String
  guesses    String[]
  solved     Boolean   @default(false)
  finishedAt DateTime?

  user User @relation("wordsmithPlaysByUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameDate])
  @@map(name: "wordsmith_plays")
}
